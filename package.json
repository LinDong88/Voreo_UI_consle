{
  "name": "voreo-console",
  "private": true,
  "version": "1.0.0",
  "description": "Voreo USB host console — ASR / TTS",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:bridge\"",
    "dev:ui": "vite",
    "dev:bridge": "node server/index.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production node server/index.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serialport": "^13.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true,
    "esbuild@0.25.12": true
  }
}
